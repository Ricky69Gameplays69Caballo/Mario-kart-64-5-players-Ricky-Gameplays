+    if (!root.contains("ControllerDeviceAssignments")) return;
+    const auto& block = root["ControllerDeviceAssignments"];
+    if (!block.is_object() || !block.contains("Devices") || !block["Devices"].is_array()) return;
+    for (const auto& device : block["Devices"]) {
+        if (!device.is_object() || !device.contains("Key") || !device["Key"].is_string() ||
+            !device.contains("IgnoredPorts") || !device["IgnoredPorts"].is_number_unsigned()) continue;
